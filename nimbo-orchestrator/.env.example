# ── Video generation aggregator (pick ONE as default) ───────────────────────────
# Default routing is through fal.ai so the model stays swappable.
FAL_KEY=

# Alternative aggregator (set PROVIDER=replicate in code to use this instead)
REPLICATE_API_TOKEN=

# ── Google Gemini key — powers TWO optional features ────────────────────────────
#   1. Veo direct video (model="veo-direct") — drops the aggregator markup (~$0.03/s)
#   2. Music generation via Lyria 3 (the default music provider) — generate_song()
GEMINI_API_KEY=

# ── Optional: alternative music generators (pipeline also works with a manual MP3) ─
SUNO_API_KEY=
ELEVENLABS_API_KEY=

# ── Which aggregator to use: "fal" (default) or "replicate" ──────────────────────
PROVIDER=fal
