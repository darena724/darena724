# ── Video generation aggregator (pick ONE as default) ───────────────────────────
# Default routing is through fal.ai so the model stays swappable.
FAL_KEY=

# Alternative aggregator (set PROVIDER=replicate in code to use this instead)
REPLICATE_API_TOKEN=

# ── Optional: Veo direct via Google (model="veo-direct") ────────────────────────
# Once Veo is locked as the workhorse, this drops the aggregator markup (~$0.03/s).
GEMINI_API_KEY=

# ── Optional: music generation (pipeline also works with a manually-dropped MP3) ─
SUNO_API_KEY=
ELEVENLABS_API_KEY=

# ── Which aggregator to use: "fal" (default) or "replicate" ──────────────────────
PROVIDER=fal
